# Backend environment variables
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# ─── MongoDB ────────────────────────────────────────────────────────────────
# Full MongoDB Atlas connection string (SRV or standard format)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=5000

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret

# ─── Gemini AI ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# ─── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of additional allowed origins (no trailing slash).
# Your production frontend URL must be here.
# Example: ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=https://collab-code-pi.vercel.app

# ─── Email (Nodemailer / Gmail SMTP) ────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
# Use a Gmail App Password (not your main password)
EMAIL_PASS=xxxx xxxx xxxx xxxx

# ─── Frontend URL (used in email reset-password links) ──────────────────────
CLIENT_URL=https://collab-code-pi.vercel.app

# ─── Notes ──────────────────────────────────────────────────────────────────
# Judge0: no API key required; the free public endpoint is used directly.
# Recording uploads: stored on local disk under backend/uploads/interviews.
#   On Render (ephemeral filesystem) recordings are lost on redeploy.
#   For permanent storage, replace the upload logic with an S3/Cloudinary call.
