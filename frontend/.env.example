# Frontend environment variables
# Copy this file to .env (local dev) or .env.production (Vite production build).
# Never commit the real .env files to version control.

# ─── API ─────────────────────────────────────────────────────────────────────
# Full URL to the backend /api prefix (no trailing slash after /api)
# Development:   http://localhost:5000/api
# Production:    https://<your-render-service>.onrender.com/api
VITE_API_URL=https://collab-code-backend.onrender.com/api

# ─── Socket.IO ──────────────────────────────────────────────────────────────
# Root URL of the backend (no path, no trailing slash)
# Development:   http://localhost:5000
# Production:    https://<your-render-service>.onrender.com
VITE_SOCKET_URL=https://collab-code-backend.onrender.com

# ─── WebRTC TURN server (optional but recommended for production) ─────────────
# Leave blank to rely on STUN-only (works on most networks, may fail behind
# symmetric NAT/firewalls). Provide a TURN server for maximum reliability.
# Example: VITE_TURN_URL=turn:openrelay.metered.ca:80
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
